---
import MainLayout from '../layouts/MainLayout.astro';
const gateway = import.meta.env.PUBLIC_API_GATEWAY_URL || (import.meta.env.DEV ? 'http://localhost:3000' : '');
---
<MainLayout title="Galerías"><section class="page"><p class="eyebrow">ESPACIOS DE ARTE</p><h1>Galerías</h1><p class="intro">Conoce los espacios que representan a nuestros artistas.</p><div class="cards" id="gallery-list" aria-live="polite"><p>Cargando galerías...</p></div></section></MainLayout>
<script define:vars={{ gateway }}>
  const list = document.querySelector('#gallery-list');
  const addText = (parent, tag, value) => {
    const node = document.createElement(tag);
    node.textContent = value ?? '';
    parent.append(node);
  };
  fetch(`${gateway}/api/galleries`)
    .then((response) => {
      if (!response.ok) throw new Error(`Galleries API returned ${response.status}`);
      return response.json();
    })
    .then((data) => {
      list.replaceChildren();
      for (const gallery of data.items || []) {
        const card = document.createElement('article');
        card.className = 'card';
        addText(card, 'h2', gallery.name);
        addText(card, 'p', [gallery.city, gallery.country].filter(Boolean).join(', '));
        addText(card, 'p', gallery.description);
        addText(card, 'small', `${Array.isArray(gallery.artist_ids) ? gallery.artist_ids.length : 0} artistas relacionados`);
        const link = document.createElement('a');
        link.className = 'button';
        link.href = `/galleries/${encodeURIComponent(gallery.id)}`;
        link.textContent = 'Ver galería';
        card.append(link);
        list.append(card);
      }
    })
    .catch((error) => {
      console.error('No se pudieron cargar las galerías.', error);
      const message = document.createElement('p');
      message.textContent = 'No se pudieron cargar las galerías.';
      list.replaceChildren(message);
    });
</script>

<style is:global>
  #gallery-list .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  #gallery-list .card small {
    display: block;
    margin-top: 6px;
    color: #55534e;
    font-size: 12px;
  }
  #gallery-list .card .button {
    margin-top: 22px;
  }
</style>
