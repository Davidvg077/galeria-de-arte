---
import MainLayout from '../layouts/MainLayout.astro';
const apiGatewayUrl = import.meta.env.PUBLIC_API_GATEWAY_URL || (import.meta.env.DEV ? 'http://localhost:3000' : '');
---
<MainLayout title="Acceso de usuarios">
  <section class="page auth-page">
    <p class="eyebrow">GART GALLERY</p>
    <div class="auth-shell">
      <div class="auth-intro">
        <h1>Tu espacio dentro de GART</h1>
        <p>Accede como visitante para explorar y comprar, o como artista para administrar y publicar tus obras.</p>
        <a href="/" class="guest-link">Seguir explorando como invitado →</a>
      </div>
      <div class="auth-card">
        <div class="tabs">
          <button class="tab active" type="button" data-tab="login">Iniciar sesión</button>
          <button class="tab" type="button" data-tab="register">Registrarse</button>
        </div>
        <form id="login-form" class="auth-form">
          <label>Usuario<input name="username" autocomplete="username" required maxlength="50" /></label>
          <label>Contraseña<input name="password" type="password" autocomplete="current-password" required maxlength="128" /></label>
          <button class="button" type="submit">Iniciar sesión</button>
          <button class="text-button" type="button" id="show-forgot">¿Olvidaste tu contraseña?</button>
        </form>
        <form id="register-form" class="auth-form hidden">
          <label>Usuario<input name="username" autocomplete="username" minlength="3" maxlength="50" required /></label>
          <label>Correo electrónico<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          <label>Contraseña<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
          <label>Tipo de cuenta<select name="role"><option value="VISITANTE">Visitante · explorar y comprar</option><option value="ARTISTA">Artista · gestionar y publicar obras</option></select></label>
          <button class="button" type="submit">Crear cuenta</button>
        </form>
        <form id="forgot-form" class="auth-form hidden">
          <p>Si el correo está registrado y verificado, recibirás un código de recuperación.</p>
          <label>Correo electrónico<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <button class="button" type="submit">Enviar código</button>
          <button class="text-button" type="button" data-back-login>Volver a iniciar sesión</button>
        </form>
        <form id="reset-form" class="auth-form hidden">
          <label>Correo electrónico<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <label>Código recibido<input name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required /></label>
          <label>Nueva contraseña<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
          <button class="button" type="submit">Cambiar contraseña</button>
          <button class="text-button" type="button" id="resend-reset">Solicitar otro código</button>
        </form>
        <section id="verify-panel" class="auth-form hidden" aria-labelledby="verify-title">
          <h2 id="verify-title">Verifica tu correo</h2>
          <p>Necesitas un correo verificado para recuperar el acceso o confirmar compras.</p>
          <form id="email-form" class="auth-form hidden">
            <label>Correo electrónico<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
            <button class="button" type="submit">Guardar correo</button>
          </form>
          <button class="button" type="button" id="send-verification">Enviar código de verificación</button>
          <form id="verify-form" class="auth-form hidden">
            <label>Código recibido<input name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required /></label>
            <button class="button" type="submit">Verificar correo</button>
          </form>
        </section>
        <p id="auth-status" class="auth-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .auth-page { max-width: 1120px; }
  .auth-shell { display: grid; grid-template-columns: 1fr 420px; gap: 70px; align-items: center; margin-top: 36px; }
  .auth-intro h1 { max-width: 480px; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1; }
  .auth-intro p { color: #777; max-width: 410px; line-height: 1.7; }
  .guest-link, .text-button { color: #80602e; font-size: 13px; text-decoration: underline; text-underline-offset: 3px; }
  .auth-card { background: #fff; border: 1px solid #e5e3dd; border-radius: 5px; padding: 28px; box-shadow: 0 16px 40px #27251d0d; }
  .tabs { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid #e5e3dd; margin-bottom: 24px; }
  .tab { border: 0; background: transparent; padding: 12px 8px; color: #8d8a83; cursor: pointer; border-bottom: 2px solid transparent; }
  .tab.active { color: #252525; border-color: #b58b4d; }
  .auth-form { display: grid; gap: 14px; }
  .auth-form label { display: grid; gap: 7px; color: #555; font-size: 12px; font-weight: 600; }
  .auth-form input, .auth-form select { min-width: 0; border: 1px solid #dcd9d1; border-radius: 3px; padding: 12px; color: #222; background: #fbfaf7; font: inherit; }
  .auth-form .button { border: 0; cursor: pointer; text-align: center; margin-top: 8px; }
  .text-button { justify-self: start; border: 0; padding: 4px 0; background: transparent; cursor: pointer; }
  .auth-status { min-height: 22px; color: #555; font-size: 12px; line-height: 1.5; }
  .auth-status.error { color: #a0473f; }
  .hidden { display: none !important; }
  #verify-panel { border-top: 1px solid #e5e3dd; margin-top: 20px; padding-top: 18px; }
  #verify-panel h2 { margin: 0; font-size: 20px; }
  #verify-panel p, #forgot-form p { color: #73736f; font-size: 13px; line-height: 1.6; }
  @media (max-width: 800px) { .auth-shell { grid-template-columns: 1fr; gap: 25px; } .auth-card { max-width: 520px; width: 100%; } }
</style>

<script define:vars={{ apiGatewayUrl }}>
  const loginForm = document.querySelector('#login-form');
  const registerForm = document.querySelector('#register-form');
  const forgotForm = document.querySelector('#forgot-form');
  const resetForm = document.querySelector('#reset-form');
  const verifyPanel = document.querySelector('#verify-panel');
  const emailForm = document.querySelector('#email-form');
  const verifyForm = document.querySelector('#verify-form');
  const status = document.querySelector('#auth-status');
  const tabs = document.querySelectorAll('.tab');
  let currentUser = null;

  const showStatus = (message, error = false) => {
    status.textContent = message;
    status.classList.toggle('error', error);
  };
  const forms = [loginForm, registerForm, forgotForm, resetForm];
  const showForm = (form) => forms.forEach((item) => item.classList.toggle('hidden', item !== form));
  const api = async (path, payload, method = 'POST') => {
    const response = await fetch(`${apiGatewayUrl}/api/auth/${path}`, {
      method,
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      ...(payload ? { body: JSON.stringify(payload) } : {}),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.detail || 'No se pudo completar la solicitud.');
    return data;
  };
  const startSession = (user) => {
    currentUser = user;
    verifyPanel.classList.toggle('hidden', user.email_verified);
    emailForm.classList.toggle('hidden', Boolean(user.email));
    document.querySelector('#send-verification').classList.toggle('hidden', !user.email || user.email_verified);
    if (user.email_verified) verifyForm.classList.add('hidden');
  };

  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const login = tab.dataset.tab === 'login';
    tabs.forEach((item) => item.classList.toggle('active', item === tab));
    showForm(login ? loginForm : registerForm);
    showStatus('');
  }));
  document.querySelector('#show-forgot').addEventListener('click', () => {
    showForm(forgotForm);
    showStatus('');
  });
  document.querySelectorAll('[data-back-login]').forEach((button) => button.addEventListener('click', () => {
    showForm(loginForm);
    showStatus('');
  }));

  loginForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      const data = await api('login', Object.fromEntries(new FormData(loginForm)));
      startSession(data.user);
      if (data.user.email_verified) {
        window.location.assign(data.user.role === 'WEBMASTER' ? '/dashboard' : data.user.role === 'ARTISTA' ? '/artist/dashboard' : '/');
      } else {
        showForm(loginForm);
        showStatus('Sesión iniciada. Verifica tu correo para recuperar la cuenta y confirmar compras.');
      }
    } catch (error) {
      showStatus(error.message, true);
    }
  });

  registerForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      const data = await api('register', Object.fromEntries(new FormData(registerForm)));
      startSession(data.user);
      showForm(loginForm);
      tabs.forEach((item) => item.classList.toggle('active', item.dataset.tab === 'login'));
      showStatus('Cuenta creada. Verifica tu correo para recuperar el acceso y confirmar compras.');
      if (data.user.email) {
        try {
          await api('email/verification/request');
          verifyForm.classList.remove('hidden');
          showStatus('Te enviamos un código para verificar tu correo.');
        } catch (error) {
          showStatus(`Cuenta creada, pero no se pudo enviar el código: ${error.message}`, true);
        }
      }
    } catch (error) {
      showStatus(error.message, true);
    }
  });

  forgotForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = new FormData(forgotForm).get('email');
    try {
      await api('password/forgot', { email });
      resetForm.elements.email.value = email;
      showForm(resetForm);
      showStatus('Si el correo está registrado y verificado, recibirás un código.');
    } catch (error) {
      showStatus(error.message, true);
    }
  });
  document.querySelector('#resend-reset').addEventListener('click', async () => {
    try {
      await api('password/forgot', { email: resetForm.elements.email.value });
      showStatus('Si el correo está registrado y verificado, recibirás un nuevo código.');
    } catch (error) {
      showStatus(error.message, true);
    }
  });
  resetForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      await api('password/reset', Object.fromEntries(new FormData(resetForm)));
      showForm(loginForm);
      resetForm.reset();
      showStatus('Contraseña actualizada. Ya puedes iniciar sesión.');
    } catch (error) {
      showStatus(error.message, true);
    }
  });

  emailForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      await api('email', Object.fromEntries(new FormData(emailForm)), 'PUT');
      currentUser.email = emailForm.elements.email.value;
      emailForm.classList.add('hidden');
      document.querySelector('#send-verification').classList.remove('hidden');
      showStatus('Correo guardado. Solicita un código para verificarlo.');
    } catch (error) {
      showStatus(error.message, true);
    }
  });
  document.querySelector('#send-verification').addEventListener('click', async () => {
    try {
      await api('email/verification/request');
      verifyForm.classList.remove('hidden');
      showStatus('Te enviamos un código de verificación.');
    } catch (error) {
      showStatus(error.message, true);
    }
  });
  verifyForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      await api('email/verification/confirm', Object.fromEntries(new FormData(verifyForm)));
      verifyPanel.classList.add('hidden');
      showStatus('Correo verificado correctamente.');
      if (currentUser?.role === 'WEBMASTER') window.location.assign('/dashboard');
      if (currentUser?.role === 'ARTISTA') window.location.assign('/artist/dashboard');
    } catch (error) {
      showStatus(error.message, true);
    }
  });

  fetch(`${apiGatewayUrl}/api/auth/me`, { credentials: 'include' })
    .then(async (response) => {
      if (response.status === 401) return null;
      if (!response.ok) throw new Error(`No se pudo validar la sesión (${response.status}).`);
      return response.json();
    })
    .then((session) => {
      if (session?.user) startSession(session.user);
    })
    .catch((error) => console.error('No se pudo validar la sesión.', error));
</script>
