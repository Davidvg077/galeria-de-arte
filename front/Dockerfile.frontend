FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY astro.config.mjs ./
COPY src ./src
COPY public ./public
COPY deploy/kubernetes/nginx.conf ./deploy/kubernetes/nginx.conf
ARG PUBLIC_API_GATEWAY_URL=""
ENV PUBLIC_API_GATEWAY_URL=${PUBLIC_API_GATEWAY_URL}
RUN npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine

COPY deploy/kubernetes/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
