FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services

WORKDIR /app

COPY services/requirements.txt /app/services/requirements.txt
RUN pip install --no-cache-dir -r /app/services/requirements.txt \
    && useradd --system --uid 10001 --create-home app

COPY services /app/services

ARG SERVICE_DIRECTORY
ENV SERVICE_DIRECTORY=${SERVICE_DIRECTORY}
WORKDIR /app/services/${SERVICE_DIRECTORY}
USER 10001:10001

CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:?PORT is required}"]
